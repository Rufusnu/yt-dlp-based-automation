# Folder that holds yt-dlp.conf, archive/ and downloads/ (the web app keeps its data in <YT_BASE>/webui)
YT_BASE=/home/youruser/scripts/yt-dlp
# Where finished tracks are copied (must be on the mount below), and the mount point itself
YT_NAS=/mnt/nas/music/downloads
YT_NAS_MOUNT=/mnt/nas
# Run the container as the user that owns YT_BASE (id -u : id -g) and add the group that may write to the NAS
UID_GID=1000:1000
EXTRA_GID=1001
TZ=Europe/Bucharest
